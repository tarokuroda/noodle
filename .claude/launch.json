{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "noodle.app:app", "--app-dir", "backend", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "friend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NOODLE_PROFILE=friend&& python -m uvicorn noodle.app:app --app-dir backend --port 8766"],
      "port": 8766
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
